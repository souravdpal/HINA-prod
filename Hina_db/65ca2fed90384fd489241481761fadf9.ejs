<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="flex-1 min-w-0">
      <h1 class="text-3xl font-extrabold text-gray-900 leading-tight">Admin Dashboard</h1>
      <p class="text-sm text-gray-500 mt-1">Manage and curate your product catalog & affiliate links.</p>
    </div>
  </div>

  <% if (error) { %>
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded">
      <p class="font-bold">Error:</p>
      <p><%= error %></p>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Add New Product Form Column -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sticky top-24">
        <h2 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2"><i class="fa-solid fa-square-plus text-amber-500 mr-2"></i>Add New Product</h2>
        <form action="/admin/add" method="POST" class="space-y-4">
          
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Product Title *</label>
            <input type="text" name="title" required placeholder="e.g. Mechanical Gaming Keyboard" class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Category</label>
              <input type="text" name="category" placeholder="e.g. Office" class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Price ($) *</label>
              <input type="number" step="0.01" name="price" required placeholder="19.99" class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Image URL *</label>
            <input type="url" name="imageUrl" required placeholder="Paste direct image url" class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Amazon Affiliate URL *</label>
            <input type="url" name="affiliateUrl" required placeholder="Paste your Amazon SiteStripe/Tag Link" class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Rating (1.0 to 5.0)</label>
              <input type="number" step="0.1" min="1" max="5" name="rating" placeholder="4.5" class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
            </div>
            <div class="flex items-center mt-6">
              <input type="checkbox" id="isFeatured" name="isFeatured" class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300 rounded">
              <label for="isFeatured" class="ml-2 block text-sm text-gray-900 font-semibold">Featured Post</label>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Description / Summary</label>
            <textarea name="description" rows="3" placeholder="Tell visitors why this product is amazing..." class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"></textarea>
          </div>

          <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-4 rounded-md transition duration-150 text-sm">
            Save Product
          </button>
        </form>
      </div>
    </div>

    <!-- Existing Products List Column -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center bg-gray-50">
          <h2 class="text-lg font-bold text-gray-900">Active Listing Catalog</h2>
          <span class="bg-amber-100 text-amber-800 font-semibold text-xs px-2.5 py-1 rounded-full"><%= products.length %> total items</span>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-100 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
              <tr>
                <th class="px-6 py-3">Product Info</th>
                <th class="px-6 py-3">Category</th>
                <th class="px-6 py-3">Price</th>
                <th class="px-6 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm">
              <% products.forEach(product => { %>
                <tr class="hover:bg-gray-50/50 transition">
                  <td class="px-6 py-4 flex items-center space-x-3">
                    <img src="<%= product.imageUrl %>" class="w-12 h-12 object-contain bg-gray-50 border rounded p-1" alt="">
                    <div class="max-w-xs md:max-w-md">
                      <p class="font-bold text-gray-900 truncate"><%= product.title %></p>
                      <a href="<%= product.affiliateUrl %>" target="_blank" class="text-xs text-amber-600 hover:underline truncate block">
                        <%= product.affiliateUrl %>
                      </a>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-gray-600">
                    <span class="bg-gray-100 text-gray-800 text-xs px-2.5 py-0.5 rounded font-semibold"><%= product.category %></span>
                  </td>
                  <td class="px-6 py-4 font-black text-gray-900">
                    $<%= product.price %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="inline-flex space-x-2">
                      <a href="/product/<%= product.id %>" class="text-indigo-600 hover:text-indigo-900 transition font-bold text-xs" title="View Detail Page">
                        <i class="fa-solid fa-eye"></i> View
                      </a>
                      <a href="/admin/delete/<%= product.id %>" onclick="return confirm('Are you sure you want to delete this product?');" class="text-red-600 hover:text-red-900 transition font-bold text-xs" title="Delete Product">
                        <i class="fa-solid fa-trash-can"></i> Delete
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
