  "astrophyics_mcp": [
    {
      "name": "get_nasa_media_links",
      "description": "",
      "input_schema": {
        "properties": {
          "query": {
            "title": "query",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "title": "max_results",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "get_nasa_media_linksArguments",
        "type": "object"
      }
    },
    {
      "name": "get_astronomy_picture_of_the_day",
      "description": "Fetch NASA's Astronomy Picture of the Day (APOD).\n    date: optional 'YYYY-MM-DD' string. Defaults to today.",
      "input_schema": {
        "properties": {
          "date": {
            "default": null,
            "title": "date",
            "type": "string"
          }
        },
        "title": "get_astronomy_picture_of_the_dayArguments",
        "type": "object"
      }
    },
    {
      "name": "get_mars_rover_photos",
      "description": "Fetch Mars rover photos.\n    rover: 'curiosity', 'opportunity', 'spirit', or 'perseverance'\n    sol: Martian day number since landing (an alternative to earth_date)\n    camera: optional camera abbreviation e.g. 'FHAZ', 'NAVCAM', 'MAST'",
      "input_schema": {
        "properties": {
          "rover": {
            "default": "curiosity",
            "title": "rover",
            "type": "string"
          },
          "sol": {
            "default": 1000,
            "title": "sol",
            "type": "string"
          },
          "camera": {
            "default": null,
            "title": "camera",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "title": "max_results",
            "type": "string"
          }
        },
        "title": "get_mars_rover_photosArguments",
        "type": "object"
      }
    },
    {
      "name": "get_near_earth_objects",
      "description": "Fetch near-Earth asteroid data for a date range (max 7 days).\n    Dates in 'YYYY-MM-DD'. Defaults to today through today.",
      "input_schema": {
        "properties": {
          "start_date": {
            "default": null,
            "title": "start_date",
            "type": "string"
          },
          "end_date": {
            "default": null,
            "title": "end_date",
            "type": "string"
          }
        },
        "title": "get_near_earth_objectsArguments",
        "type": "object"
      }
    },
    {
      "name": "get_iss_location",
      "description": "Fetch the current real-time latitude/longitude of the International Space Station.",
      "input_schema": {
        "properties": {},
        "title": "get_iss_locationArguments",
        "type": "object"
      }
    },
    {
      "name": "get_people_in_space",
      "description": "Fetch the list of astronauts currently in space, and which craft they're aboard.",
      "input_schema": {
        "properties": {},
        "title": "get_people_in_spaceArguments",
        "type": "object"
      }
    },
    {
      "name": "search_space_info",
      "description": "Search recent space news/updates directly from NASA, ESA, and ISRO sources\n    (own lightweight RSS/HTML scraper defined in this file \u2014 no external search\n    engine or AI summarizer is used). Good for questions like \"latest Chandrayaan\n    update\" or \"recent NASA Artemis news\".",
      "input_schema": {
        "properties": {
          "query": {
            "title": "query",
            "type": "string"
          },
          "max_results": {
            "default": 8,
            "title": "max_results",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "search_space_infoArguments",
        "type": "object"
      }
    }
  ]
