{
  "github_mcp": [
    {
      "name": "github_get_repo_context",
      "description": "Fetches high-level repository details: description, stars, forks,\n    open issue/PR counts, primary languages, topics, license, and a README\n    snippet. Use this first when you need orientation on a repo.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          }
        },
        "required": [
          "repo_name"
        ],
        "title": "github_get_repo_contextArguments",
        "type": "object"
      }
    },
    {
      "name": "github_search_repos",
      "description": "Searches GitHub for repositories matching a query\n    (e.g. 'language:python stars:>1000 llm agent').",
      "input_schema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 8,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "github_search_reposArguments",
        "type": "object"
      }
    },
    {
      "name": "github_list_branches",
      "description": "Lists branches on a repository, flagging the default branch.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "repo_name"
        ],
        "title": "github_list_branchesArguments",
        "type": "object"
      }
    },
    {
      "name": "github_list_commits",
      "description": "Lists recent commits on a repo (optionally filtered to a branch\n    and/or file path) with author, message, and short SHA.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "branch": {
            "default": "",
            "title": "Branch",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          },
          "path": {
            "default": "",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "repo_name"
        ],
        "title": "github_list_commitsArguments",
        "type": "object"
      }
    },
    {
      "name": "github_get_file_content",
      "description": "Fetches the text content of a specific file in a repo at a given\n    ref (branch/tag/sha). Useful for reading source before editing or\n    reviewing. Binary files are reported but not decoded.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "ref": {
            "default": "",
            "title": "Ref",
            "type": "string"
          }
        },
        "required": [
          "repo_name",
          "file_path"
        ],
        "title": "github_get_file_contentArguments",
        "type": "object"
      }
    },
    {
      "name": "github_search_code",
      "description": "Searches code within a specific repository for a string/symbol.\n    Great for 'where is X defined/used' questions.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "repo_name",
          "query"
        ],
        "title": "github_search_codeArguments",
        "type": "object"
      }
    },
    {
      "name": "github_manage_issues",
      "description": "Manages issues on a repo.\n    Actions:\n      'list'    - top 10 open issues\n      'create'  - needs `title` (and optionally `body`, `labels` comma-separated)\n      'read'    - needs `issue_number`, returns issue + comments\n      'comment' - needs `issue_number` and `comment`\n      'close'   - needs `issue_number`\n      'reopen'  - needs `issue_number`",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "body": {
            "default": "",
            "title": "Body",
            "type": "string"
          },
          "issue_number": {
            "default": 0,
            "title": "Issue Number",
            "type": "integer"
          },
          "labels": {
            "default": "",
            "title": "Labels",
            "type": "string"
          },
          "comment": {
            "default": "",
            "title": "Comment",
            "type": "string"
          }
        },
        "required": [
          "repo_name",
          "action"
        ],
        "title": "github_manage_issuesArguments",
        "type": "object"
      }
    },
    {
      "name": "github_actions_logs",
      "description": "Queries recent GitHub Actions workflow runs, filtered by status\n    ('failure', 'success', 'in_progress', etc.) and returns run metadata\n    for debugging or status reporting.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "status": {
            "default": "failure",
            "title": "Status",
            "type": "string"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "repo_name"
        ],
        "title": "github_actions_logsArguments",
        "type": "object"
      }
    },
    {
      "name": "github_rerun_workflow",
      "description": "Re-triggers a specific workflow run by its numeric run ID\n    (get this from github_actions_logs).",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "integer"
          }
        },
        "required": [
          "repo_name",
          "run_id"
        ],
        "title": "github_rerun_workflowArguments",
        "type": "object"
      }
    },
    {
      "name": "github_manage_pull_requests",
      "description": "Manages pull requests.\n    Actions:\n      'list'    - top 10 open PRs\n      'analyze' - needs `pr_number`, returns diff + metadata for review\n      'create'  - needs `title`, `head`, `base` (and optionally `body`)\n      'comment' - needs `pr_number` and `comment`\n      'merge'   - needs `pr_number` (optionally `merge_method`: merge/squash/rebase)",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "action": {
            "title": "Action",
            "type": "string"
          },
          "pr_number": {
            "default": 0,
            "title": "Pr Number",
            "type": "integer"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "body": {
            "default": "",
            "title": "Body",
            "type": "string"
          },
          "head": {
            "default": "",
            "title": "Head",
            "type": "string"
          },
          "base": {
            "default": "",
            "title": "Base",
            "type": "string"
          },
          "comment": {
            "default": "",
            "title": "Comment",
            "type": "string"
          },
          "merge_method": {
            "default": "merge",
            "title": "Merge Method",
            "type": "string"
          }
        },
        "required": [
          "repo_name",
          "action"
        ],
        "title": "github_manage_pull_requestsArguments",
        "type": "object"
      }
    },
    {
      "name": "github_list_releases",
      "description": "Lists recent releases/tags for a repo with changelog snippets.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "limit": {
            "default": 8,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "repo_name"
        ],
        "title": "github_list_releasesArguments",
        "type": "object"
      }
    },
    {
      "name": "github_get_notifications",
      "description": "Fetches the authenticated user's GitHub notifications\n    (mentions, review requests, CI failures on watched repos, etc.).",
      "input_schema": {
        "properties": {
          "limit": {
            "default": 15,
            "title": "Limit",
            "type": "integer"
          },
          "unread_only": {
            "default": true,
            "title": "Unread Only",
            "type": "boolean"
          }
        },
        "title": "github_get_notificationsArguments",
        "type": "object"
      }
    },
    {
      "name": "github_star_repo",
      "description": "Stars or unstars a repository. `action` is 'star' or 'unstar'.",
      "input_schema": {
        "properties": {
          "repo_name": {
            "title": "Repo Name",
            "type": "string"
          },
          "action": {
            "default": "star",
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "repo_name"
        ],
        "title": "github_star_repoArguments",
        "type": "object"
      }
    }
  ],
